# Copy to .env for a new installation. Keep credentials out of Git.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

database.default.hostname = 127.0.0.1
database.default.database = tfa1
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.DBDebug = false

# For deployment use production, the actual HTTPS base URL, a dedicated database
# user and the host's database credentials. Do not overwrite an existing .env.
